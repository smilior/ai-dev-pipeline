# Anthropic API Key（claude-code-action で使用）
ANTHROPIC_API_KEY=sk-ant-xxx

# GitHub Personal Access Token（repo, workflow スコープ）
GITHUB_TOKEN=ghp_xxx

# 対象リポジトリ（owner/repo）
GITHUB_REPO=smilior/your-project

# Self-hosted Runner 登録トークン
# 取得: gh api repos/{owner}/{repo}/actions/runners/registration-token -f --jq '.token'
RUNNER_TOKEN=

# Runner 識別名
RUNNER_NAME=claude-runner

# Runner ラベル
RUNNER_LABELS=self-hosted
