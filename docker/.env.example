# GitHub Personal Access Token（repo, workflow スコープ）
GITHUB_TOKEN=ghp_xxx

# 対象リポジトリ（owner/repo）
GITHUB_REPO=smilior/your-project

# Self-hosted Runner 登録トークン
# 取得: gh api repos/{owner}/{repo}/actions/runners/registration-token --jq '.token'
RUNNER_TOKEN=

# Runner 識別名
RUNNER_NAME=claude-runner

# Runner ラベル
RUNNER_LABELS=self-hosted

# ※ Claude Code はホストの ~/.claude を読み取り専用マウントして認証します
#   事前にホストで `claude` を起動し Max プランでログインしてください
